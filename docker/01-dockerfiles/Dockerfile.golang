# ==============================================================================
# Ultra-Minimal Go Production Dockerfile (Scratch Base)
# ==============================================================================
# Produces a self-contained, statically linked binary running on 'scratch'
# (0MB OS overhead) with SSL CA certificates and a non-root user.
# ==============================================================================

# Stage 1: Build static binary
FROM golang:1.22-alpine AS builder

# Install CA certificates (required for outbound HTTPS calls)
RUN apk --no-cache add ca-certificates git

WORKDIR /app

# Cache dependencies
COPY go.mod go.sum* ./
RUN go mod download

COPY . .

# Compile static binary: CGO_ENABLED=0 strips C library dependencies
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o /app/server .

# Create non-root user in builder
RUN echo "appuser:x:10001:10001:App User:/:/sbin/nologin" > /etc/passwd_app

# ------------------------------------------------------------------------------
# Stage 2: Scratch (Empty) Runtime Container
# ------------------------------------------------------------------------------
FROM scratch

# Copy CA certificates from builder stage
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy non-root user
COPY --from=builder /etc/passwd_app /etc/passwd

# Copy statically compiled binary
COPY --from=builder /app/server /server

USER appuser

EXPOSE 8080

ENTRYPOINT ["/server"]
